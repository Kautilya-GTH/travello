# Copy this file to .streamlit/secrets.toml and fill in your key.
# secrets.toml is git-ignored. On Streamlit Cloud, paste these lines
# into App settings -> Secrets instead.
GEMINI_API_KEY = "paste-your-key-here"

# Check Google AI Studio for the current Flash model name and update if needed.
GEMINI_MODEL = "gemini-2.5-flash"
